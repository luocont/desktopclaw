# 1. 忽略 node_modules（核心！包含electron.exe等大文件）
node_modules/
frontend/node_modules/
# 2. 忽略构建产物（dist/dist-electron，都是自动生成的）
dist/
dist-electron/

# 3. 忽略npm缓存/日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 4. 忽略环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 5. 忽略Electron相关缓存
electron-builder-cache/
electron-builder-effective-config.yaml

# 6. 忽略编辑器/系统文件
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 7. Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# 8. 后端打包二进制与运行时依赖
backend/_internal/
backend/*.exe
backend/*.dll
backend/*.pyd
backend/*.pkg
backend/case/*.gif

# 9. Electron 运行时与构建产物
electron/

# 10. 前端静态资源（模型、图片、音频、第三方库等）
frontend/public/
public/

# 11. PyInstaller / 构建输出
build/
dist/